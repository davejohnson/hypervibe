            "deprecated": true
          },
          "slug": {
            "type": "string",
            "pattern": "^[\\w-]+$",
            "description": "Organization slug",
            "example": "tsrqponmlkjihgfedcba"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "slug",
          "name"
        ]
      }
