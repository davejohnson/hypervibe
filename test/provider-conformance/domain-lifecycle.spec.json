{
  "version": 1,
  "project": "hypervibe-domain-conformance",
  "gitRemoteUrl": "https://github.com/davejohnson/hypervibe.git",
  "runtime": {
    "kind": "node",
    "version": "24"
  },
  "environments": {
    "railway": {
      "hosting": {
        "provider": "railway"
      },
      "services": {
        "web": {
          "workloadKind": "web",
          "startCommand": "node test/provider-conformance/fixture/server.mjs",
          "healthCheckPath": "/health",
          "public": true
        }
      },
      "domain": "railway.domain-test.hypervibe.dev",
      "domainProxy": false,
      "email": {
        "enabled": false
      },
      "envVars": {
        "CONFORMANCE_APP_REVISION": "railway-v1"
      },
      "deploy": {
        "strategy": "manual"
      }
    }
  }
}
