{
 "scripts": {
  "databaseTransferScript": "cac694dc8cf7c2f4bf2a78576c2212bf0c3783509915810f4e1f103968f2fca5",
  "databaseExportScript": "c550d48083b478ba090555e37dc0aec6282039313f4cb8f1f45cc05632830df8",
  "databaseRestoreScript": "45b85875670ad81ef1f18da45c6875e8448b5ecb01cd147739b82ac02593b3aa",
  "databaseManifestScript": "755550e6b6b59c31f9085458a2f1e95b70f3b71a40fc462d9c348d886668599d",
  "storageTransferScript": "cd1dbf02eaa1518bd50f86053386ab8760408d973fedd299fbb241ff0b36b5f3",
  "storageCheckScript": "04b93d0b1d391f6d60e46cba3c05087f0b47e4727766b6c39593a32e740f41dd"
 },
 "databaseCopyJob": {
  "labels": {
   "managed-by": "hypervibe",
   "hv-temporary": "true",
   "hv-transfer": "<random>"
  },
  "template": {
   "template": {
    "serviceAccount": "runtime@demo-project.iam.gserviceaccount.com",
    "maxRetries": 0,
    "timeout": "3600s",
    "containers": [
     {
      "image": "postgres:16-alpine",
      "command": [
       "/bin/sh"
      ],
      "args": [
       "-c",
       "echo synthetic"
      ],
      "env": [
       {
        "name": "PGTZ",
        "value": "UTC"
       },
       {
        "name": "DATABASE_URL",
        "valueSource": {
         "secretKeyRef": {
          "secret": "hv-production-database-url",
          "version": "3"
         }
        }
       }
      ],
      "resources": {
       "limits": {
        "cpu": "2",
        "memory": "4Gi"
       }
      },
      "volumeMounts": [
       {
        "name": "cloudsql",
        "mountPath": "/cloudsql"
       }
      ]
     }
    ],
    "volumes": [
     {
      "name": "cloudsql",
      "cloudSqlInstance": {
       "instances": [
        "demo-project:us-central1:hv-production-db-a1b2c3"
       ]
      }
     }
    ]
   }
  }
 },
 "storageCopyJob": {
  "labels": {
   "managed-by": "hypervibe",
   "hv-temporary": "true",
   "hv-transfer": "<random>"
  },
  "template": {
   "template": {
    "serviceAccount": "runtime@demo-project.iam.gserviceaccount.com",
    "maxRetries": 0,
    "timeout": "3600s",
    "containers": [
     {
      "image": "rclone/rclone:1.68.2",
      "command": [
       "/bin/sh"
      ],
      "args": [
       "-c",
       "echo synthetic"
      ],
      "env": [
       {
        "name": "SOURCE_BUCKET",
        "value": "a"
       }
      ],
      "resources": {
       "limits": {
        "cpu": "2",
        "memory": "4Gi"
       }
      }
     }
    ]
   }
  }
 }
}
