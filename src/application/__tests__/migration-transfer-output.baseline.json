 "databaseCopyJob": {
  "labels": {
   "managed-by": "hypervibe",
   "hv-temporary": "true",
   "hv-transfer": "<random>"
  },
  "template": {
   "template": {
    "serviceAccount": "runtime@demo-project.iam.gserviceaccount.com",
    "maxRetries": 0,
    "timeout": "3600s",
    "containers": [
     {
      "image": "postgres:16-alpine",
      "command": [
       "/bin/sh"
      ],
      "args": [
       "-c",
       "echo synthetic"
      ],
      "env": [
       {
        "name": "PGTZ",
        "value": "UTC"
       },
       {
        "name": "DATABASE_URL",
        "valueSource": {
         "secretKeyRef": {
          "secret": "hv-production-database-url",
          "version": "3"
         }
        }
       }
      ],
      "resources": {
       "limits": {
        "cpu": "2",
        "memory": "4Gi"
       }
      },
      "volumeMounts": [
       {
        "name": "cloudsql",
        "mountPath": "/cloudsql"
       }
      ]
     }
    ],
    "volumes": [
     {
      "name": "cloudsql",
      "cloudSqlInstance": {
       "instances": [
        "demo-project:us-central1:hv-production-db-a1b2c3"
       ]
      }
     }
    ]
   }
  }
 },
 "storageCopyJob": {
  "labels": {
   "managed-by": "hypervibe",
   "hv-temporary": "true",
   "hv-transfer": "<random>"
  },
  "template": {
   "template": {
    "serviceAccount": "runtime@demo-project.iam.gserviceaccount.com",
    "maxRetries": 0,
    "timeout": "3600s",
    "containers": [
     {
      "image": "rclone/rclone:1.68.2",
