    "google_workflows_workflow": {
     "worker_waker": {
      "name": "worker-waker",
      "project": "demo-project",
      "region": "us-west1",
      "description": "Scales worker worker between 0 and 1 instance from its pending work.",
      "service_account": "hypervibe-runtime@demo-project.iam.gserviceaccount.com",
      "deletion_protection": false,
      "labels": {
       "managed-by": "hypervibe",
       "hv-environment": "env-123"
      },
      "source_contents": "{\"main\":{\"steps\":[{\"count\":{\"try\":{\"steps\":[{\"query\":{\"call\":\"http.post\",\"args\":{\"url\":\"https://sqladmin.googleapis.com/v1/projects/demo-project/instances/hv-staging-db/executeSql\",\"auth\":{\"type\":\"OAuth2\"},\"body\":{\"database\":\"app\",\"sqlStatement\":\"SELECT count(*) FROM jobs\",\"autoIamAuthn\":true,\"rowLimit\":\"1\",\"application\":\"hv-waker-worker\"}},\"result\":\"sql\"}},{\"read\":{\"assign\":[{\"pending\":\"$${int(sql.body.results[0].rows[0].values[0].value)}\"},{\"want\":\"$${if(pending > 0, 1, 0)}\"},{\"readError\":\"\"}]}}]},\"except\":{\"as\":\"error\",\"steps\":[{\"fallback\":{\"assign\":[{\"pending\":-1},{\"want\":1},{\"readError\":\"$${default(map.get(error, \\\"message\\\"), \\\"the pending-work query failed\\\")}\"}]}}]}}},{\"current\":{\"call\":\"http.get\",\"args\":{\"url\":\"https://run.googleapis.com/v2/projects/demo-project/locations/us-west1/workerPools/worker\",\"auth\":{\"type\":\"OAuth2\"}},\"result\":\"observed\"}},{\"report\":{\"assign\":[{\"outcome\":{\"instances\":\"$${want}\",\"pendingWork\":\"$${pending}\",\"readError\":\"$${readError}\"}}]}},{\"compare\":{\"switch\":[{\"condition\":\"$${default(map.get(observed.body.scaling, \\\"manualInstanceCount\\\"), 0) == want}\",\"return\":\"$${outcome}\"}]}},{\"scale\":{\"call\":\"http.patch\",\"args\":{\"url\":\"https://run.googleapis.com/v2/projects/demo-project/locations/us-west1/workerPools/worker?updateMask=scaling.manualInstanceCount\",\"auth\":{\"type\":\"OAuth2\"},\"body\":{\"scaling\":{\"scalingMode\":\"MANUAL\",\"manualInstanceCount\":\"$${want}\"}}}}},{\"done\":{\"return\":\"$${outcome}\"}}]}}"
     }
    },
    "google_cloud_run_v2_worker_pool_iam_member": {
     "worker_waker": {
      "project": "demo-project",
      "location": "us-west1",
      "name": "${google_cloud_run_v2_worker_pool.worker.name}",
      "role": "roles/run.developer",
      "member": "serviceAccount:hypervibe-runtime@demo-project.iam.gserviceaccount.com"
     }
    }
   }
  },
