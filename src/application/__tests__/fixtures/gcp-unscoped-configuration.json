         {
          "condition": "${self.settings[0].edition != \"ENTERPRISE_PLUS\" || !(startswith(self.settings[0].tier, \"db-custom-\") || contains([\"db-f1-micro\", \"db-g1-small\"], self.settings[0].tier))}",
