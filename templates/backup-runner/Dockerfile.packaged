# The input is the exact reviewed npm tarball, including its shipped dependency
# lock. The planner records both hashes and tests the resulting local image ID.
FROM node:24-bookworm-slim AS build
WORKDIR /opt/hypervibe
COPY package.tgz /tmp/package.tgz
RUN tar -xzf /tmp/package.tgz --strip-components=1 \
    && cp dist/operator-artifacts/package-lock.json package-lock.json \
    && npm ci --omit=dev --ignore-scripts

FROM postgres:16-bookworm AS runtime
COPY --from=build /usr/local/bin/node /usr/local/bin/node
WORKDIR /opt/hypervibe
COPY --from=build /opt/hypervibe/package.json ./package.json
COPY --from=build /opt/hypervibe/dist ./dist
COPY --from=build /opt/hypervibe/node_modules ./node_modules
USER postgres
ENTRYPOINT ["node", "/opt/hypervibe/dist/ci/backup-runner.js"]
